<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional, git-ignored: mods/local.props sets SR1LabPath / SR2LabPath to your own game folders. -->
  <Import Project="../local.props" Condition="Exists('../local.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <SR1LabPath Condition="'$(SR1LabPath)' == ''">../../Lab/Games/SR1</SR1LabPath>
    <AssemblyName>SlimeBridge.SR1</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="SRML">
      <HintPath>$(SR1LabPath)/SlimeRancher_Data/Managed/SRML.dll</HintPath>
      <Private>false</Private>
    </Reference>
