<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity-free core: parses an sbconv runtime package. netstandard2.0 loads under SRML (net472/Mono) and MelonLoader (net6). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SbRuntime</RootNamespace>
    <AssemblyName>SbRuntime.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
